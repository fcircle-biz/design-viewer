            { "label": "親取引先ID", "name": "parent_account_id", "type": "bigint", "key": "FK", "note": "accounts.id（自己参照）" },
            { "label": "所有者ID", "name": "owner_id", "type": "bigint", "key": "FK", "note": "users.id" },
            { "label": "取引先コード", "name": "account_code", "type": "varchar", "note": "受注データ出力に使う" }
          ] },
        { "id": "T_CONTACTS", "kind": "er", "tone": "blue", "label": "取引先責任者", "sub": "contacts",
          "fields": [
            { "label": "責任者ID", "name": "id", "type": "bigint", "key": "PK" },
            { "label": "取引先ID", "name": "account_id", "type": "bigint", "key": "FK", "note": "accounts.id（必須）" },
            { "label": "氏名", "name": "name", "type": "varchar" },
            { "label": "役職", "name": "title", "type": "varchar" },
            { "label": "メールアドレス", "name": "email", "type": "varchar" },
            { "label": "電話番号", "name": "phone", "type": "varchar" },
            { "label": "所有者ID", "name": "owner_id", "type": "bigint", "key": "FK", "note": "users.id" }
          ] },
        { "id": "T_OPPS", "kind": "er", "tone": "green", "label": "商談", "sub": "opportunities",
