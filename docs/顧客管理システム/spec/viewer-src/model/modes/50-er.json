            { "label": "リードID", "name": "id", "type": "bigint", "key": "PK" },
            { "label": "会社名", "name": "company", "type": "varchar" },
            { "label": "氏名", "name": "name", "type": "varchar" },
            { "label": "メールアドレス", "name": "email", "type": "varchar" },
            { "label": "電話番号", "name": "phone", "type": "varchar" },
            { "label": "都道府県", "name": "prefecture", "type": "varchar", "note": "割り当てルールに使う" },
            { "label": "獲得元", "name": "source", "type": "varchar", "note": "Web など" },
            { "label": "ステータス", "name": "status", "type": "varchar", "note": "新規／対応中／評価済み／不適格" },
