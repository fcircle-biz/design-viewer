{
  "modes": {
    "er": {
      "label": "ER図",
      "desc": "仕様書のデータモデルにある 16 テーブル。所有者（owner_id）はすべて users を参照する。活動の関連先（related_type + related_id）は複数テーブルを指すため FK の線を引いていない。",
      "nodes": [
        { "id": "T_ROLES", "kind": "er", "tone": "slate", "label": "ロール", "sub": "roles",
          "info": ["parent_role_id で同じテーブルの親ロールを参照する（ロール階層）。"],
          "fields": [
            { "label": "ロールID", "name": "id", "type": "bigint", "key": "PK" },
            { "label": "ロール名", "name": "name", "type": "varchar", "note": "営業担当／営業マネージャー／サポート担当／システム管理者" },
            { "label": "親ロールID", "name": "parent_role_id", "type": "bigint", "key": "FK", "note": "roles.id（自己参照）" }
          ] },
        { "id": "T_TEAMS", "kind": "er", "tone": "slate", "label": "チーム", "sub": "teams",
          "fields": [
            { "label": "チームID", "name": "id", "type": "bigint", "key": "PK" },
            { "label": "チーム名", "name": "name", "type": "varchar" },
            { "label": "マネージャーID", "name": "manager_id", "type": "bigint", "key": "FK", "note": "users.id" }
          ] },
        { "id": "T_USERS", "kind": "er", "tone": "slate", "label": "ユーザー", "sub": "users",
          "info": ["manager_id で同じテーブルの上司を参照する。", "5 回連続でログインに失敗すると locked_until に 30 分後の日時を入れる。"],
          "fields": [
            { "label": "ユーザーID", "name": "id", "type": "bigint", "key": "PK" },
            { "label": "氏名", "name": "name", "type": "varchar" },
            { "label": "メールアドレス", "name": "email", "type": "varchar", "key": "UK" },
            { "label": "ロールID", "name": "role_id", "type": "bigint", "key": "FK", "note": "roles.id" },
            { "label": "チームID", "name": "team_id", "type": "bigint", "key": "FK", "note": "teams.id" },
            { "label": "上司ID", "name": "manager_id", "type": "bigint", "key": "FK", "note": "users.id（自己参照）" },
            { "label": "有効フラグ", "name": "is_active", "type": "boolean" },
            { "label": "ロック解除日時", "name": "locked_until", "type": "datetime" }
          ] },
        { "id": "T_LEADS", "kind": "er", "tone": "amber", "label": "リード", "sub": "leads",
