        { "id": "B09", "variant": "end", "lane": "L_SALES", "phase": "PH2", "label": "不適格で終了" },
        { "id": "B10", "variant": "task", "lane": "L_SALES", "phase": "PH2", "label": "評価済みにして取引開始する", "screen": "S05",
