        { "id": "B11", "variant": "system", "lane": "L_SYS", "phase": "PH2", "label": "取引先・責任者・商談を作成する", "sub": "リードは読み取り専用に",
          "spec": ["業務ルール（リード）: 取引開始したリードは読み取り専用になり、作成した取引先・取引先責任者・商談へのリンクを持つ。"] },

        { "id": "B12", "variant": "task", "lane": "L_SALES", "phase": "PH3", "label": "要件を確認し提案する", "sub": "フェーズを進める", "screen": "S10",
          "spec": ["業務ルール（商談）: フェーズと確度の既定値は 見込み 10% → 要件確認 25% → 提案 50% → 見積提示 75% → 交渉 90% → 受注 100% ／ 失注 0%。"] },
        { "id": "B13", "variant": "task", "lane": "L_SALES", "phase": "PH3", "label": "見積を作成する", "sub": "明細・値引を入力", "screen": "S11",
